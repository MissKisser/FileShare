{
    "name": "fileshare/fileshare",
    "description": "轻量级文件上传与文本存储系统 (PHP 7.4+ / SQLite)",
    "type": "project",
    "license": "MIT",
    "authors": [
        {
            "name": "Hackerdallas"
        }
    ],
    "require": {
        "php": ">=7.4",
        "ext-pdo": "*",
        "ext-pdo_sqlite": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-fileinfo": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6"
    },
    "suggest": {
        "ext-gd": "用于图片缩略图生成",
        "ext-imagick": "用于更高质量的图片缩略图（替代 GD）",
        "ext-zip": "用于 ZIP 压缩包在线预览",
        "ext-phar": "用于 TAR/GZ 压缩包在线预览"
    },
    "autoload": {
        "files": [
            "src/config.php",
            "src/database.php",
            "src/functions.php"
        ]
    },
    "scripts": {
        "test": "phpunit",
        "test-manual": "@php tests/test_owner_delete.php",
        "lint": "find src -name '*.php' -exec php -l {} \\;"
    },
    "config": {
        "platform": {
            "php": "7.4"
        }
    }
}
